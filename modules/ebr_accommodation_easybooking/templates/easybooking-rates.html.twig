{{ attach_library('ebr_accommodation_easybooking/rates') }}

<div id="ebPricesFrame"></div>

<script type="text/javascript">
  function ebPricesLoadedCheck() {
    if (typeof jQuery != "undefined") {
      if (jQuery.fn.ebPricelist) {
        jQuery("#ebPricesFrame").ebPricelist({
          customerId: "{{- drupal_config('system.site', 'easybooking.customer_id') -}}",
          serialNo: "{{- drupal_config('system.site', 'easybooking.serial_nr') -}}",
          localeId: "{{- entity.getWidgetLangId(langcode) -}}",
          loadCSS : true,
          arrivalDate : "{{ arrival_date_iso }}",
          category : "{{ entity.get('remote_id').0.value }}",
          showAvailability: false,
          enquiryPage : "{{- entity.getActionUrl('enquiry').toString ?? 'popup' -}}",
          bookingPage : "{{- entity.getActionUrl('book').toString ?? 'popup' -}}",
          bookingEngine: 2
        });
      } else { setTimeout(ebPricesLoadedCheck, 200); }
    } else { setTimeout(ebPricesLoadedCheck, 200); }
  }
</script>
