{% set attributes = attributes ?? create_attribute() %}
{% set attributes = attributes.addClass('seekda-availabilities') %}

{% block before %}{% endblock %}

{% block calendar %}
  {{ attach_library('ebr_accommodation_seekda/availabilities') }}
  <div {{ attributes }}
    x-data="{
      startDate: undefined,
      endDate: undefined,
      firstAvailableDate: undefined,
      availabilities: {},
      {# By default prices are rounded to nearest integer due limited space. -#}
      {% block price_formatter -%}
      getFormattedPrice: function(price) {
        return Math.round(price) + '&euro;';
      },
      {% endblock -%}
      runFlatpickr() {
        let flatpickrInstance = window.flatpickr(this.$refs.flatpickr, {
          inline: true,
          locale: document.documentElement.getAttribute('lang'),
          showMonths: ($store.breakpoint == 'xs' ? 1 : 2),
          onDayCreate: (selectedDates, dateStr, instance, dayElem) => {
            let currentDay = new Date(dayElem.dateObj.toISOString());
            /* normalize all times to 12:00 to avoid problems with timezones or summertime */
            currentDay.setHours(12,0,0,0);
            if (currentDay < $data.startDate || currentDay > $data.endDate) {
              return;
            }
            let currentIsoDay = currentDay.toISOString().substring(0,10);
            if ($data.availabilities[currentIsoDay] && $data.availabilities[currentIsoDay].price && $data.availabilities[currentIsoDay].available) {
              dayElem.classList.add('seekda-is-available');
              dayElem.innerHTML += `<span class='seekda-availability-dayprice'>` + $data.getFormattedPrice($data.availabilities[currentIsoDay].price) + `</span>`;
            }
            else {
              dayElem.classList.add('seekda-is-not-available');
            }
          },
        });
        flatpickrInstance.jumpToDate(new Date($data.firstAvailableDate), true);
        this.$watch('$store.breakpoint', (breakpoint) => {
          let m = (breakpoint == 'xs' ? 1 : 2);
          if (flatpickrInstance.config['showMonths'] != m) {
            flatpickrInstance.set('showMonths', m);
            if (m==1) {
              flatpickrInstance.calendarContainer.style.removeProperty('width');
              flatpickrInstance.calendarContainer.querySelector('.flatpickr-days').style.removeProperty('width');
            }
          }
        });
      },
    }"
    x-init="(async () => {
      startDate = new Date();
      {# normalize all times to 12:00 to avoid problems with timezones or summertime -#}
      startDate.setHours(12,0,0,0);
      let endpoint = `{{ endpoint|e('js') }}&skd-language-code=${document.documentElement.getAttribute('lang')}&skd-start-date=${startDate.toISOString().substring(0,10)}`;
      let json = await( await fetch(endpoint) ).json();
      let remoteId = '{{- entity.get("remote_id").value -}}';
      {% if entity.bundle() == 'package' -%}
        let rates = json.overview.entities.filter(rate => (rate.isPackage == true && rate.rate_code == remoteId));
      {% elseif entity.bundle() == 'room' -%}
        let rates = json.overview.entities.filter(rate => (rate.isPackage == false && rate.room_code == remoteId));
      {% endif -%}
      {# By default prices in packages are per person and prices in rooms are per day. -#}
      {% block price_divisor -%}
        const getPriceDivisor = function(rate) {
          {%- if entity.bundle() == 'package' -%}
            return rate?.std_occupancy ?? 1;
          {%- else -%}
            return 1;
          {%- endif -%}
        };
      {% endblock -%}
      rates.forEach((rate, i) => {
        let priceDivisor = getPriceDivisor(rate);
        rate.prices.forEach((price, j) => {
          let currentDay = new Date();
          currentDay.setDate(currentDay.getDate() + j);
          currentDay.setHours(12,0,0,0);
          currentDay = currentDay.toISOString().substring(0,10);
          availabilities[currentDay] = availabilities[currentDay] ?? {
            date: currentDay,
            price: 0,
            available: 0,
          };
          if (!price || !rate.availabilities[j]) {
            return;
          };
          if (!firstAvailableDate || currentDay < firstAvailableDate) {
            firstAvailableDate = currentDay;
          }
          if (availabilities[currentDay].price == 0 || availabilities[currentDay].price > price) {
            availabilities[currentDay].price = price / priceDivisor;
            availabilities[currentDay].available = rate.availabilities[j];
          }
        });
      });
      endDate = new Date();
      endDate.setHours(12,0,0,0);
      endDate.setDate(endDate.getDate() + Object.keys(availabilities).length);
      if (window.flatpickr) {
        runFlatpickr();
      } else {
        document.addEventListener('flatpickr:loaded', () => {$data.runFlatpickr()}, {once: true});
      }
    })()">
    <input type="hidden" class="hidden" x-ref="flatpickr" name="dummy_flatpickr_anchor" />
  </div>
{% endblock %}

{% block after %}{% endblock %}
